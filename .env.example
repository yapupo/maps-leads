# Pais padrao para formatar numeros de telefone (55 = Brasil)
DEFAULT_COUNTRY_CODE=55

# Porta do servidor (padrão: 3000)
PORT=3000

# ─── Autenticação (obrigatório quando REMOTE_TUNNEL=true) ──────────────────────
# Defina usuario e senha para proteger o acesso remoto
AUTH_USER=admin
AUTH_PASS=troque_para_uma_senha_forte

# ─── Acesso Remoto via Cloudflare Tunnel ──────────────────────────────────────
# true  = abre túnel HTTPS público (use do celular / fora de casa)
# false = só acesso local (http://localhost:PORT)
REMOTE_TUNNEL=false

# ─── Email (Nodemailer) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu@email.com
# Para Gmail: use uma "Senha de app" (não sua senha normal)
# Gere em: https://myaccount.google.com/apppasswords
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# ─── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_HEADLESS=false
SCRAPER_DELAY_MIN=1500
SCRAPER_DELAY_MAX=3500

# Arquivo de saída dos contatos
CSV_FILE=contacts.csv
